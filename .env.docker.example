MYSQL_DATABASE=nest_admin
MYSQL_APP_USER=nest_admin
MYSQL_APP_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-the-initial-admin-password

JWT_ACCESS_SECRET=replace-with-a-random-32-byte-access-secret
JWT_REFRESH_SECRET=replace-with-a-random-32-byte-refresh-secret
OAUTH_REDIRECT_BASE_URL=https://admin.example.com/api/auth/oauth
OAUTH_FRONTEND_CALLBACK_URL=https://admin.example.com/oauth/callback
OAUTH_ENCRYPTION_KEY=replace-with-a-random-32-byte-oauth-secret

LOG_RETENTION_DAYS=90
LOG_ARCHIVE_PREFIX=archives/logs
LOG_ARCHIVE_DRIVER=local
LOG_ARCHIVE_LOCAL_DIR=.log-archives
LOG_ARCHIVE_S3_ENDPOINT=
LOG_ARCHIVE_S3_REGION=us-east-1
LOG_ARCHIVE_S3_BUCKET=
LOG_ARCHIVE_S3_ACCESS_KEY_ID=
LOG_ARCHIVE_S3_SECRET_ACCESS_KEY=
LOG_ARCHIVE_S3_FORCE_PATH_STYLE=false

SWAGGER_ENABLED=false
WEB_PORT=5173
WEB_HTTPS_PORT=5443
CADDY_SITE_ADDRESS=:80
API_PORT=3000
VITE_API_BASE=/api
