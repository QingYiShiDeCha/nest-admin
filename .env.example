# 运行环境：development / test / production
NODE_ENV=development
PORT=3000
# 所有接口的统一前缀，文档挂在 ${API_PREFIX}/docs
API_PREFIX=api
SWAGGER_ENABLED=true

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nest_admin
DB_POOL_LIMIT=10

# JWT 密钥，至少 16 位。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-32-byte-hex
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace-me-with-another-random-32-byte-hex
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt 成本因子，越大越慢越安全
BCRYPT_SALT_ROUNDS=10

# 全局限流：每 IP 在 THROTTLE_TTL 秒内最多 THROTTLE_LIMIT 次请求
# 登录/注册另有更严格的固定阈值（60 秒 5 次），见 packages/shared 的 LOGIN_THROTTLE
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# 部署在 nginx 等反向代理之后必须设为 true，否则所有请求的来源 IP 都是代理地址，
# 限流会退化成全站共用一个配额；直接暴露公网时必须保持 false，
# 否则客户端可伪造 X-Forwarded-For 绕过限流
TRUST_PROXY=false
