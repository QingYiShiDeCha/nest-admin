# 运行环境：development / test / production
NODE_ENV=development
PORT=3000
# 所有接口的统一前缀，文档挂在 ${API_PREFIX}/docs
API_PREFIX=api
SWAGGER_ENABLED=true

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nest_admin
DB_POOL_LIMIT=10

# JWT 密钥，至少 16 位。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-32-byte-hex
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace-me-with-another-random-32-byte-hex
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt 成本因子，越大越慢越安全
BCRYPT_SALT_ROUNDS=10

# 全局限流：每 IP 在 THROTTLE_TTL 秒内最多 THROTTLE_LIMIT 次请求
# 登录/注册另有更严格的固定阈值（60 秒 5 次），见 packages/shared 的 LOGIN_THROTTLE
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# 部署在 nginx 等反向代理之后必须设为 true，否则所有请求的来源 IP 都是代理地址，
# 限流会退化成全站共用一个配额；直接暴露公网时必须保持 false，
# 否则客户端可伪造 X-Forwarded-For 绕过限流
TRUST_PROXY=false

# 限流计数的存放位置。不配则用进程内存——多实例部署时每个实例各算各的，
# 实际配额会按实例数翻倍。配上之后各实例共享同一份计数。
# 格式：redis://[:password@]host:port[/db]
# REDIS_URL=redis://127.0.0.1:6379/0
# 用户角色、权限与数据范围缓存 TTL（秒）；Redis 未配置时自动回退数据库
RBAC_CACHE_TTL_SECONDS=300
DICT_CACHE_TTL_SECONDS=300

# 操作日志保留天数，超期由定时任务物理删除
LOG_RETENTION_DAYS=90
# 清理任务的 cron，默认每天凌晨 3 点
LOG_CLEANUP_CRON=0 3 * * *
# 关掉定时清理（想完全交给运维处理时）
LOG_CLEANUP_ENABLED=true

# 文件上传：local 或 s3。接口为 POST /api/files/upload，multipart 字段名 file
UPLOAD_DRIVER=local
# 单文件大小上限，单位 MB
UPLOAD_MAX_FILE_SIZE_MB=10
# 逗号分隔，支持 image/* 与 */* 通配符
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/zip

# 本地存储目录相对仓库根解析，文件通过 /uploads/... 访问
UPLOAD_LOCAL_DIR=.uploads
UPLOAD_LOCAL_URL_PREFIX=/uploads

# S3 / S3 兼容存储。AWS S3 可留空 endpoint；MinIO、阿里云 OSS S3 接口等填写 endpoint
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_REGION=us-east-1
UPLOAD_S3_BUCKET=
# 留空时使用运行环境提供的 IAM Role / 默认凭证链
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
# MinIO 等通常需要 true，AWS S3 与多数 OSS 使用 false
UPLOAD_S3_FORCE_PATH_STYLE=false
# 可选 CDN 或公开访问域名；留空时根据 endpoint/bucket 自动生成对象 URL
UPLOAD_S3_PUBLIC_BASE_URL=
