{
  "name": "nest-admin",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS + Drizzle + MySQL 后台管理系统 monorepo",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm --filter @nest-admin/api start:dev",
    "start:prod": "pnpm --filter @nest-admin/api start:prod",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:api && pnpm lint:web",
    "format": "prettier --write \"{apps,packages}/*/{src,test}/**/*.ts\"",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm build:packages && pnpm --filter @nest-admin/api test:e2e",
    "clean": "node -e \"for (const p of require('fast-glob').sync(['apps/*/dist','packages/*/dist','**/*.tsbuildinfo'],{onlyFiles:false,ignore:['**/node_modules/**']})) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "db:generate": "pnpm build:packages && pnpm --filter @nest-admin/database db:generate",
    "db:migrate": "pnpm build:packages && pnpm --filter @nest-admin/database db:migrate",
    "db:push": "pnpm build:packages && pnpm --filter @nest-admin/database db:push",
    "db:studio": "pnpm build:packages && pnpm --filter @nest-admin/database db:studio",
    "db:seed": "pnpm build:packages && pnpm --filter @nest-admin/database db:seed",
    "lint:api": "eslint . --fix",
    "lint:web": "pnpm --filter @nest-admin/web lint",
    "format:web": "pnpm --filter @nest-admin/web format"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-glob": "^3.3.3",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.17.0"
}
